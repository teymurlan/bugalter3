{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bugalter3",
  "main": "src/demo-worker-v30-contact-links.js",
  "compatibility_date": "2026-09-03",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CONSENT_STORE",
        "class_name": "ConsentStore"
      },
      {
        "name": "APP_STORE",
        "class_name": "AppStore"
      }
    ]
  },
  "exports": {
    "ConsentStore": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "AppStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
